	(text "Here I'm using a voltage divider to get 0.6875\ntimes the 3.7V battery voltage, because the MCU's\nADC can only handle 3.3V"
		(exclude_from_sim no)
		(at 277.114 72.136 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "06097132-17cd-468e-932f-fcd8781e0bb9")
	)
	(text "Power"
		(exclude_from_sim no)
		(at 88.646 20.32 0)
		(effects
			(font
				(size 5.08 5.08)
			)
		)
		(uuid "07282b78-0558-442d-b664-2b0ce21aeb65")
	)
	(text "The SX1262 is a common LoRa module for meshtastic nodes.\nTo simplify things and make it easier to solder, I've\nchosen the affordable Wio-SX1262 module by Seeed Studio.\nThis module also has built-on shielding."
		(exclude_from_sim no)
		(at 223.266 138.684 0)
		(effects
			(font
				(size 1.016 1.016)
			)
		)
		(uuid "15300ccf-12a8-4424-87ff-362cb78c5923")
	)
	(text "These sockets connect via SPI to the LCD display"
		(exclude_from_sim no)
		(at 30.734 159.004 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "28c47ecc-2001-449d-bb96-4ea8e4e4fb67")
	)
	(text "D"
